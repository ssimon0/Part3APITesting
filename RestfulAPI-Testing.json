  "item": [
    {
      "name": "Authentication",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\n\r\npm.test(\"Authentication successful\", function () {\r\n    pm.response.to.have.status(200);\r\n    pm.expect(response.token).to.exist;\r\n});\r\n\r\npm.environment.set(\"token\", response.token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"username\": \"admin\",\r\n    \"password\": \"password123\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/auth",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\n\r\npm.environment.set(\"bookingid\", response.bookingid);\r\n\r\npm.environment.set(\"expectedFirstname\", response.booking.firstname);\r\npm.environment.set(\"expectedLastname\", response.booking.lastname);\r\npm.environment.set(\"expectedPrice\", response.booking.totalprice);\r\npm.environment.set(\"expectedNeeds\", response.booking.additionalneeds);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\" : \"John\",\r\n    \"lastname\" : \"Doe\",\r\n    \"totalprice\" : 100,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2026-11-14\",\r\n        \"checkout\" : \"2026-11-16\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Booking",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Booking updated successfully\", function () {\r\n    pm.response.to.have.status(200);\r\n});"
            ]
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const requestBody = JSON.parse(pm.request.body.raw);\r\n\r\npm.environment.set(\"expectedFirstname\", requestBody.firstname);\r\npm.environment.set(\"expectedLastname\", requestBody.lastname);\r\npm.environment.set(\"expectedPrice\", requestBody.totalprice);\r\npm.environment.set(\"expectedNeeds\", requestBody.additionalneeds);"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "token={{token}}"
          },
          {
            "key": "Authorization",
            "value": "Basic"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"firstname\" : \"Juan\",\r\n    \"lastname\" : \"Dela Cruz\",\r\n    \"totalprice\" : 110,\r\n    \"depositpaid\" : true,\r\n    \"bookingdates\" : {\r\n        \"checkin\" : \"2026-11-14\",\r\n        \"checkout\" : \"2026-11-15\"\r\n    },\r\n    \"additionalneeds\" : \"Breakfast\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/booking/{{bookingid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "booking",
            "{{bookingid}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Verify Update",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const response = pm.response.json();\r\n\r\npm.test(\"Booking retrieved successfully\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"First name matches\", function () {\r\n    pm.expect(response.firstname)\r\n        .to.eql(pm.environment.get(\"expectedFirstname\"));\r\n});\r\n\r\npm.test(\"Last name matches\", function () {\r\n    pm.expect(response.lastname)\r\n        .to.eql(pm.environment.get(\"expectedLastname\"));\r\n});\r\n\r\npm.test(\"Total price matches\", function () {\r\n    pm.expect(response.totalprice)\r\n        .to.eql(Number(pm.environment.get(\"expectedPrice\")));\r\n});\r\n\r\npm.test(\"Additional needs matches\", function () {\r\n    pm.expect(response.additionalneeds)\r\n        .to.eql(pm.environment.get(\"expectedNeeds\"));\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
